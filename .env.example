
# ----- Global settings -----

PORT=3000

# Log verbosity: fatal | error | warn | info | debug | trace | silent
# Leave unset to auto-pick: "info" in production, "debug" otherwise.
# Set to "silent" to disable all logs.
# LOG_LEVEL=info

# Maximum number of artwork URLs collected across providers
MAX_ARTWORKS=2


# Minimum file size in MB required to trim the audio before identification.
# Files smaller than this threshold are sent as-is.
TRIM_THRESHOLD_MB=1


# Reverse-proxy hops to trust for the client IP (Express `trust proxy`).
# 0 = trust nothing (req.ip is the socket IP; a spoofed X-Forwarded-For is
# ignored). Behind a single proxy/ingress set 1 so per-IP rate limiting sees
# the real client instead of the proxy.
TRUST_PROXY=0


# ----- Throttle (rate limiting, per IP) -----
# METADATA (GET /songs): cheap lookup — permissive.
# IDENTIFY (POST /songs/identify): heavy (audio processing + paid APIs) — strict.
# Formula: max LIMIT requests per TTL milliseconds.
THROTTLE_METADATA_TTL=1000
THROTTLE_METADATA_LIMIT=100
THROTTLE_IDENTIFY_TTL=5000
THROTTLE_IDENTIFY_LIMIT=3


# ---- Redis (Caching) ----
# Default host is localhost, port 6379. 
# REDIS_TTL is in seconds (e.g., 3600 = 1 hour).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=3600

# ---- Last.fm ----
# Create an API account at: https://www.last.fm/api/account/create
# Then copy your keys from: https://www.last.fm/api/accounts
LASTFM_API_KEY=YOUR_API_KEY
LASTFM_SECRET=YOUR_SECRET


# ---- MusicBrainz ----
# No API key required, but a contact email is mandatory (used in the User-Agent header).
# Rate-limiting rules: https://musicbrainz.org/doc/MusicBrainz_API/Rate_Limiting
MUSICBRAINZ_EMAIL=YOUR_EMAIL



# ---- AcoustID (audio fingerprinting) ----
# Open fingerprint database powered by Chromaprint. Requires the `fpcalc` binary
# (install Chromaprint tools natively).
# 1. Sign in:   https://acoustid.org/login
# 2. Register an application: https://acoustid.org/new-application
# 3. Copy the Application API Key into ACOUSTID_API_KEY.
ACOUSTID_API_KEY=YOUR_API_KEY


# ---- AudD (audio fingerprinting) ----
# Sign up and grab the API token at: https://dashboard.audd.io
AUDD_API_KEY=YOUR_API_KEY


# ---- ACRCloud (audio fingerprinting) ----
# 1. Create an account: https://console.acrcloud.com/signup
# 2. Create an "Audio & Video Recognition" project, then copy:
#      Host           -> ACRCLOUD_URL (prepend https:// and append /v1/identify)
#      Access Key     -> ACRCLOUD_API_KEY
#      Access Secret  -> ACRCLOUD_SECRET
# The default URL points at EU-West; users in other regions must override it.
ACRCLOUD_API_KEY=YOUR_API_KEY
ACRCLOUD_SECRET=YOUR_SECRET
ACRCLOUD_URL=https://identify-eu-west-1.acrcloud.com/v1/identify
